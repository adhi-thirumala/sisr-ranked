WORKER_API_BASE=https://rir.example.com
AGENT_SERVICE_TOKEN=replace-with-worker-agent-token
SERVICE_API_TOKEN=replace-with-worker-service-token
CLOUDFLARED_TOKEN=replace-with-cloudflare-tunnel-token

MATCH_IMAGE=localhost/rir-game:latest
VELOCITY_IMAGE=localhost/sisr-velocity:latest

MATCH_MEMORY=768m
MATCH_MEMORY_SWAP=768m
MATCH_CPUS=1.5
MATCH_TIMEOUT=15m
STOP_GRACE=30s
VIEW_DISTANCE=6
SIMULATION_DISTANCE=4
PREGEN_RADIUS=12
JVM_FLAGS=-Xms200m -Xmx480m -XX:+UseG1GC -XX:MaxGCPauseMillis=50
