/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sisr-ranked",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUEUE", "class_name": "Queue" },
      { "name": "MATCH", "class_name": "Match" },
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sisr-ranked",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "kv_namespaces": [
    { "binding": "ROUTING", "id": "00000000000000000000000000000000" },
    { "binding": "CACHE", "id": "00000000000000000000000000000000" },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Queue", "Match"] },
  ],
  "vars": {
    "AGENT_BASE_URL": "https://agent.example.internal",
    "OAUTH_REDIRECT_URI": "https://example.com/api/auth/microsoft/callback",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
